# Copy to `.env` and fill in. `.env` is gitignored - never commit it.

# The contract's deployer principal (the address you deployed from).
# The live testnet deployment of covault-core is:
CONTRACT_ADDRESS=
CONTRACT_NAME=

# Network: testnet or mainnet
NETWORK=testnet

# YOUR OWN 24-word testnet mnemonic - used to sign transactions.
# NEVER commit a real seed phrase. `.env` is gitignored; this example file is
# published, so it must only ever contain a placeholder.
MNEMONIC="word word word ... your own 24-word testnet seed phrase"
